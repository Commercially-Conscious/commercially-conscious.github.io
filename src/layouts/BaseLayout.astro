---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A weekly roundup of financial and economic news headlines.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} · Commercially Conscious</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrapper header-row">
        <a class="brand" href={base}>
          <span class="logo-mark" aria-hidden="true">
            <span>Commercially</span>
            <span>Conscious</span>
          </span>
          <span class="brand-tagline">Commercially Conscious</span>
        </a>
        <button class="nav-toggle" id="nav-toggle" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="site-nav">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
        <nav class="site-nav" id="site-nav">
          <a href={base}>Digests</a>
          <a href={`${base}articles/`}>Articles</a>
          <a href={`${base}categories/`}>Categories</a>
          <a href={`${base}about/`}>About</a>
          <a href={`${base}search/`}>Search</a>
        </nav>
      </div>
    </header>

    <script>
      const toggle = document.getElementById('nav-toggle');
      const nav = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const isOpen = nav?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
      });
    </script>
    <main class="wrapper" data-pagefind-body>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrapper">
        <div class="footer-row">
          <span class="logo-mark" aria-hidden="true">
            <span>Commercially</span>
            <span>Conscious</span>
          </span>
          <nav class="footer-links">
            <a href={base}>Digests</a>
            <a href={`${base}articles/`}>Articles</a>
            <a href={`${base}categories/`}>Categories</a>
            <a href={`${base}about/`}>About</a>
          </nav>
        </div>
        <p class="fine-print">
          Each entry contains headlines and short summaries and links to the original story on the
          outlet credited beside it. This is a curated pointer digest, not a reproduction of full
          articles.
        </p>
      </div>
    </footer>
  </body>
</html>
