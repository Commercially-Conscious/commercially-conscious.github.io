---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<BaseLayout title="Articles" description="Articles written by Commercially Conscious over the months.">
  <h1 class="page-title">Articles</h1>
  <p class="page-lede">
    Longer pieces written by Jason and Ebinizer over the months, originally published on our
    LinkedIn page.
  </p>

  <div class="panel">
    <p style="margin: 0 0 1rem;">
      The full archive lives on LinkedIn — browse everything we've written there, or check back
      here as we add individual pieces to this page.
    </p>
    <a
      class="button"
      href="https://www.linkedin.com/company/commercially-conscious2026/posts/?feedView=all"
      target="_blank"
      rel="noopener noreferrer"
    >
      Read our articles on LinkedIn
    </a>
  </div>

  {
    articles.length === 0 ? (
      <p class="empty-state">Individual articles will be listed here soon.</p>
    ) : (
      <div class="card-list">
        {articles.map((article) => (
          <a class="digest-card" href={article.url} target="_blank" rel="noopener noreferrer">
            <p class="meta">{formatDate(article.data.publishedDate)}{article.data.author ? ` · ${article.data.author}` : ''}</p>
            <h2>{article.data.title}</h2>
            {article.data.excerpt && <p class="description">{article.data.excerpt}</p>}
          </a>
        ))}
      </div>
    )
  }
</BaseLayout>
