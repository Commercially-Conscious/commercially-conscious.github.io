---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const digests = (await getCollection('digests')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const base = import.meta.env.BASE_URL;

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
}

function categoriesFor(entries: { category?: string }[]) {
  return [...new Set(entries.map((e) => e.category).filter((c): c is string => Boolean(c)))];
}
---

<BaseLayout title="Home">
  {
    digests.length === 0 && (
      <p>No digests published yet. The first weekly roundup will appear here once generated.</p>
    )
  }
  {
    digests.map((digest) => (
      <article class="digest-card">
        <h2>
          <a href={`${base}digests/${digest.id}/`}>{digest.data.title}</a>
        </h2>
        <p class="meta">
          {formatDate(digest.data.weekStart)} – {formatDate(digest.data.weekEnd)}
        </p>
        <p>{digest.data.description}</p>
        <div>
          {categoriesFor(digest.data.entries).map((category) => (
            <a class="chip" href={`${base}categories/${category}/`}>
              {category}
            </a>
          ))}
        </div>
      </article>
    ))
  }
</BaseLayout>
