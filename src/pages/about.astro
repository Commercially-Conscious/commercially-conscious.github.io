---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Commercially Conscious is a legal and financial journalism page founded by Jason Semwayo and Ebinizer Kevin Karengera."
>
  <h1 class="page-title">About Commercially Conscious</h1>
  <p class="page-lede">
    A legal and financial journalism page aiming to increase the commercial awareness of students.
    Free of charge.
  </p>

  <div class="panel">
    <p style="margin: 0;">
      Commercially Conscious was founded in January 2026 to make commercial awareness accessible
      to students, without a paywall. The weekly digest on this site is one part of that: a
      no-cost roundup of the financial and economic headlines worth knowing about.
    </p>

    <div class="founders">
      <div class="founder-card">
        <strong>Jason Semwayo</strong>
        <span>Co-founder</span>
      </div>
      <div class="founder-card">
        <strong>Ebinizer Kevin Karengera</strong>
        <span>Co-founder</span>
      </div>
    </div>
  </div>

  <a
    class="button"
    href="https://www.linkedin.com/company/commercially-conscious2026/"
    target="_blank"
    rel="noopener noreferrer"
  >
    Follow Commercially Conscious on LinkedIn
  </a>

  <h2 class="page-title section-title">Your support counts</h2>
  <div class="panel">
    <p style="margin: 0;">
      If you're interested in helping this newsletter grow and continue reaching students working
      to build their commercial awareness, through sponsorship, feel free to get in touch via our{' '}
      <a href="https://www.linkedin.com/company/commercially-conscious2026/" target="_blank" rel="noopener noreferrer">LinkedIn page</a>{' '}
      or either of these emails:{' '}
      <a href="mailto:29190614@sun.ac.za">29190614@sun.ac.za</a>{' '}
      and{' '}
      <a href="mailto:28441036@sun.ac.za">28441036@sun.ac.za</a>.
    </p>
  </div>
</BaseLayout>
