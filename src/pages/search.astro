---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Search"
  description="Search Commercially Conscious for headlines, weekly digests, and categories."
>
  <h1 class="page-title">Search</h1>
  <p class="page-lede">Find any headline, weekly digest, or category we've covered.</p>

  <link href={`${base}pagefind/pagefind-component-ui.css`} rel="stylesheet" />
  <script type="module" src={`${base}pagefind/pagefind-component-ui.js`}></script>

  <div class="panel">
    <pagefind-config bundle-path={`${base}pagefind/`}></pagefind-config>
    <pagefind-input placeholder="Search headlines, digests, categories…" autofocus></pagefind-input>
    <pagefind-summary default-message="Start typing to search."></pagefind-summary>
    <pagefind-results></pagefind-results>
  </div>
</BaseLayout>
