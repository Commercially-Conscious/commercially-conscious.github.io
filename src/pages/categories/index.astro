---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const digests = await getCollection('digests');
const base = import.meta.env.BASE_URL;

const categories = [
  ...new Set(digests.flatMap((d) => d.data.entries.map((e) => e.category).filter(Boolean))),
].sort() as string[];
---

<BaseLayout title="Categories">
  <h1 class="page-title">Categories</h1>
  <p class="page-lede">Browse headlines grouped by topic across every weekly roundup.</p>
  {categories.length === 0 && <p class="empty-state">No categories yet.</p>}
  <div class="category-grid">
    {
      categories.map((category) => (
        <a class="chip" href={`${base}categories/${category}/`}>
          {category}
        </a>
      ))
    }
  </div>
</BaseLayout>
